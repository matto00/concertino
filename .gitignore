# Concertino working state (generated per-project, never committed to the plugin repo).
# This must keep covering .concertino/cache/, which holds full Linear ticket
# descriptions and comment threads — frequently more sensitive than the code.
.concertino/
scripts/concertino/.concertino.env

# Rendered harness output when this repo is used as a consuming project
/.claude/agents/concertino-*.md
/.claude/commands/concertino-*.md

# Editor / OS
.DS_Store
*.log
node_modules/

# superpowers brainstorming scratch
.superpowers/
