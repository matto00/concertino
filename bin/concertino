#!/usr/bin/env node
'use strict';

/*
 * concertino — render the agent orchestra from core/ + a project config into
 * each harness's native layout. Zero dependencies.
 *
 *   concertino init [--example=helio|generic|opencode-ollama] [--out=DIR]
 *   concertino sync [--config=PATH] [--out=DIR] [--harness=claude-code,codex,opencode] [--dry-run]
 *   concertino update <key=value> [...] [--config=PATH] [--out=DIR] [--dry-run]
 *   concertino answer <ticket> <value> [--sub <index> --total <n>] [--out=DIR]
 *   concertino help
 *
 * This file is the executable entry point only: arg parsing, the command
 * registry, and dispatch. Every command's implementation lives in its own
 * module under lib/cli/ (one per subcommand, shared plumbing in
 * lib/cli/shared.js) — this file still runs its CLI dispatch the instant it
 * is loaded, and so remains never a safe `require()` target; the lib/cli/
 * modules are.
 */

const { VERSION, red, parseArgs, hasHelpFlag } = require('../lib/cli/shared');
const { cmdInit } = require('../lib/cli/init');
const { cmdSync } = require('../lib/cli/sync');
const { cmdUpdate } = require('../lib/cli/update');
const { cmdValidate } = require('../lib/cli/validate');
const { cmdDiff } = require('../lib/cli/diff');
const { cmdDoctor } = require('../lib/cli/doctor');
const { cmdWatch } = require('../lib/cli/watch');
const { cmdPrune } = require('../lib/cli/prune');
const { cmdUpgrade } = require('../lib/cli/upgrade');
const { cmdGates } = require('../lib/cli/gates');
const { cmdCompletion } = require('../lib/cli/completion');
const { cmdEject } = require('../lib/cli/eject');
const { cmdMigrate } = require('../lib/cli/migrate');
const { cmdAnswer } = require('../lib/cli/answer');
const { help } = require('../lib/cli/help');

const args = parseArgs(process.argv.slice(2));
const cmd = args._[0] || 'watch';
if (args.version) { console.log('concertino v' + VERSION); process.exit(0); }
// Bare `concertino --help`/`-h` (no subcommand token) — without this check,
// a bare `--help` would fall through to `cmd = 'watch'` above and, once
// cmdWatch gains its own --help check, print watch's single-command usage
// instead of launching the dashboard; bare `-h` already falls through today
// to the `else help()` branch below since `-h` never matches `args._[0]` of
// any recognized command. This makes both consistently show the aggregate
// `concertino help` output (design.md Decision 5).
if (!args._[0] && hasHelpFlag(args)) { help(); process.exit(0); }
(async () => {
  try {
    if (cmd === 'init')           await cmdInit(args);
    else if (cmd === 'sync')      await cmdSync(args);
    else if (cmd === 'update')    await cmdUpdate(args);
    else if (cmd === 'validate')  await cmdValidate(args);
    else if (cmd === 'diff')      cmdDiff(args);
    else if (cmd === 'doctor')    cmdDoctor(args);
    else if (cmd === 'watch')     await cmdWatch(args);
    else if (cmd === 'prune')     cmdPrune(args);
    else if (cmd === 'upgrade')   cmdUpgrade(args);
    else if (cmd === 'gates')      cmdGates(args);
    else if (cmd === 'completion') cmdCompletion(args);
    else if (cmd === 'eject')      cmdEject(args);
    else if (cmd === 'migrate')    cmdMigrate(args);
    // `answer` gets the raw argv tokens following the subcommand name, not
    // the globally-parsed `args` object every other command above uses:
    // `--sub <index> --total <n>` are value-bearing flags interleaved with
    // two positionals (ticket, value), which parseArgs' `--k=v`-only
    // convention can't represent without losing the flag/value association
    // (see lib/cli/answer.js's own header comment).
    else if (cmd === 'answer')     await cmdAnswer(process.argv.slice(3));
    else help();
  } catch (e) {
    console.error(red('error: ') + e.message);
    process.exit(1);
  }
})();
